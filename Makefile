# Compiler Configuration
CC = gcc
CFLAGS = -O2 -std=c11 -D_GNU_SOURCE -Wall -Wextra -MMD -MP
CPPFLAGS = -Isrc -Ivendor
LDLIBS ?=

# Base Directories
OBJ_PATH = build/obj
BIN_PATH = build/bin

# Detect Operating System for platform-specific commands
ifeq ($(OS),Windows_NT)
    TARGET = $(BIN_PATH)/ordena-server.exe
    
    # Path and command handling for Windows (CMD)
    FIXPATH = $(subst /,\,$(patsubst %/,%,$1))
    MKDIR = if not exist "$(call FIXPATH,$1)" mkdir "$(call FIXPATH,$1)"
    RMDIR = if exist "build" rmdir /s /q "build"
    RUN_CMD = .\$(call FIXPATH,$(TARGET))
    
    # Native Windows socket library required by Mongoose
    LDLIBS += -lws2_32
else
    TARGET = $(BIN_PATH)/ordena-server
    
    # Standard commands for Linux/macOS
    MKDIR = mkdir -p $1
    RMDIR = rm -rf build
    RUN_CMD = ./$(TARGET)
endif

# Native Make recursive wildcard function
rwildcard = $(foreach d,$(wildcard $(1:=/*)),$(call rwildcard,$d,$2) $(filter $(subst *,%,$2),$d))

# Recursively discover all .c files in src and vendor
SRCS = $(call rwildcard,src,*.c) $(call rwildcard,vendor,*.c)

# Map .c files to .o inside build/obj
OBJS = $(patsubst %.c,$(OBJ_PATH)/%.o,$(SRCS))

# Dependency files (.d) generated by -MMD -MP
DEPS = $(OBJS:.o=.d)

.PHONY: all clean run serve rebuild

all: $(TARGET)

# Link object files into final executable
$(TARGET): $(OBJS)
	@$(call MKDIR,$(dir $@))
	$(CC) $(CFLAGS) $(CPPFLAGS) $^ -o $@ $(LDLIBS)

# Compile .c files into .o preserving directory layout
$(OBJ_PATH)/%.o: %.c
	@$(call MKDIR,$(dir $@))
	$(CC) $(CFLAGS) $(CPPFLAGS) -c $< -o $@

clean:
	@$(RMDIR)

rebuild: clean all

run serve: all
	$(RUN_CMD)

-include $(DEPS)
